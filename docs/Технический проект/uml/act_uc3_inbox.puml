@startuml act_uc3_inbox
!include _style.iuml
title Деятельность: запись дела произвольной фразой (UC-3)
|Студент|
start
:Открыть панель быстрой записи\n(кнопка или клавиша);
:Ввести фразу;
|Веб-клиент|
:POST /assistant/inbox;
|Серверная часть|
:Проверить токен и возможность «jarvis»;
if (Фраза пустая или > 2000 символов?) then (да)
  :Ответ 400/422;
  |Веб-клиент|
  :Показать ошибку;
  stop
endif
|Серверная часть|
:Переслать фразу боту\n(X-Bot-Secret, user_id, mode=inbox);
|Бот|
:Установить acting_user;
:Собрать контекст момента\n(дата, время МСК, число пар);
:Отправить модели промт записи\nи схемы инструментов;
if (Модель доступна?) then (нет)
  :Вернуть сообщение\nо недоступности разбора;
else (да)
  repeat
    :Получить ответ модели;
    if (Есть вызов инструмента?) then (да)
      :Проверить обязательные поля;
      :Вызвать ручку /api/v1/*\nот имени пользователя;
      :Вернуть модели результат;
    endif
  repeat while (Вызов инструмента и раунд < 8?) is (да)
  ->нет;
  :Удалить служебные ID из ответа;
endif
|Серверная часть|
:Сохранить фразу и ответ\n(source = inbox);
|Веб-клиент|
:Показать, какая запись создана\nи в каком разделе;
:Сбросить кэш данных страницы;
|Студент|
if (Запись создана верно?) then (нет)
  :Исправить запись в разделе;
endif
stop
@enduml
