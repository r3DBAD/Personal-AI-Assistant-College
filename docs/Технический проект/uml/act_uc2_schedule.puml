@startuml act_uc2_schedule
!include _style.iuml
title Деятельность: автоматическое обновление расписания (UC-2)
|Бот: цикл опроса VK|
start
:Дождаться очередного срока\n(8:00, 12:00, 16:00, 18:00 МСК);
:Снять снимки расписания\nна сегодня и на неделю;
:Запросить стену сообщества\nза последние 7 дней (wall.get);
if (Источник доступен?) then (нет)
  :Записать причину в журнал;
  stop
endif
if (Найден пост о выходном сегодня?) then (да)
  :Отметить выходной в календаре;
  :Сообщить владельцу;
  stop
endif
if (Найден файл xlsx?) then (нет)
  stop
endif
if (Файл уже загружался?) then (да)
  stop
endif
:Скачать файл (до 3 попыток);
:POST /schedule/upload;
|Серверная часть|
:Проверить расширение, размер ≤ 10 МБ,\nсигнатуру ZIP;
:Разобрать файл в группы и занятия;
if (Структура распознана?) then (нет)
  :Ответ 422, расписание\nне изменяется;
  |Бот: цикл опроса VK|
  :Записать ошибку в журнал;
  stop
endif
|Серверная часть|
:Для каждой группы удалить занятия\nза дни из файла и вставить новые;
:Зафиксировать транзакцию;
:Сбросить кэш расписания в Redis;
|Бот: цикл опроса VK|
:POST /schedule/sync-calendar;
|Серверная часть|
if (Перечень занятий пуст или\nкалендарь не прочитан?) then (да)
  :Отменить синхронизацию целиком;
else (нет)
  :Создать / изменить / удалить\nтолько свои события календаря;
endif
|Бот: цикл опроса VK|
:Снять снимки «после»;
if (Изменился сегодняшний день?) then (да)
  :Отправить сообщение\nс изменениями дня;
endif
if (Появились новые дни?) then (да)
  :Отправить сообщение о расписании\nна следующие дни;
  :Предложить варианты плана недели;
endif
stop
@enduml
