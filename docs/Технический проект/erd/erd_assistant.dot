digraph ERD { graph [rankdir=LR, fontname="Liberation Sans", nodesep=0.35, ranksep=0.9, splines=spline, pad=0.3];
node [shape=plain, fontname="Liberation Sans", fontsize=11];
edge [fontname="Liberation Sans", fontsize=9, dir=both, color="#333333"];
"users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>users</B><BR/><FONT POINT-SIZE="10">Учётная запись</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>U</B></TD><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>U</B></TD><TD ALIGN="LEFT">telegram_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">is_admin</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">avatar_url</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(512)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>U</B></TD><TD ALIGN="LEFT">bind_token</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">preferred_group_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">token_version</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"chat_messages" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>chat_messages</B><BR/><FONT POINT-SIZE="10">Реплика переписки</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">content</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"nudges" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>nudges</B><BR/><FONT POINT-SIZE="10">Обращение ассистента</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(48)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">body</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">payload</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">result</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">responded_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"nudge_settings" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>nudge_settings</B><BR/><FONT POINT-SIZE="10">Настройки обращений</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK,FK</B></TD><TD ALIGN="LEFT"><U>user_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">quiet_from</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">quiet_to</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">daily_budget</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INTEGER</FONT></TD></TR></TABLE>>];
"nudge_mutes" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>nudge_mutes</B><BR/><FONT POINT-SIZE="10">Отключение повода</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(48)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">muted_until</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"habit_profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>habit_profiles</B><BR/><FONT POINT-SIZE="10">Профиль привычек</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK,FK</B></TD><TD ALIGN="LEFT"><U>user_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">data</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">computed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"claude_jobs" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>claude_jobs</B><BR/><FONT POINT-SIZE="10">Задание исполнителю</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">prompt</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">subject</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(160)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">inputs</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">messages</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">container_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">result_text</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">outputs</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">cost_usd</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">NUMERIC(10,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">error</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"push_devices" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>push_devices</B><BR/><FONT POINT-SIZE="10">Устройство оповещений</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>U</B></TD><TD ALIGN="LEFT">token</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(1024)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">platform</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">keys</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">muted</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">last_seen</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"habit_profiles" -> "users" [arrowtail=teeodot, arrowhead=teeteenone, label="имеет"];
"chat_messages" -> "users" [arrowtail=crowodot, arrowhead=teeteenone, label="пишет"];
"users" -> "nudges" [arrowtail=teeteenone, arrowhead=crowodot, label="получает"];
"users" -> "nudge_settings" [arrowtail=teeteenone, arrowhead=teeodot, label="настраивает"];
"users" -> "nudge_mutes" [arrowtail=teeteenone, arrowhead=crowodot, label="отключает"];
"claude_jobs" -> "users" [arrowtail=crowodot, arrowhead=teeteenone, label="ставит"];
"users" -> "push_devices" [arrowtail=teeteenone, arrowhead=crowodot, label="регистрирует"];
}