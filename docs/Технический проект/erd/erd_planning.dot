"users" -> "car_maintenance" [arrowtail=teeteenone, arrowhead=crowodot, label="записывает"];
"users" -> "car_profiles" [arrowtail=teeteenone, arrowhead=teeodot, label="описывает"];
"weekly_reports" -> "users" [arrowtail=crowodot, arrowhead=teeteenone, label="получает"];
}