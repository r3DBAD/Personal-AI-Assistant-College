digraph ERD { graph [rankdir=LR, fontname="Liberation Sans", nodesep=0.35, ranksep=0.9, splines=spline, pad=0.3];
node [shape=plain, fontname="Liberation Sans", fontsize=11];
edge [fontname="Liberation Sans", fontsize=9, dir=both, color="#333333"];
"users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>users</B><BR/><FONT POINT-SIZE="10">Учётная запись</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>U</B></TD><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>U</B></TD><TD ALIGN="LEFT">telegram_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">is_admin</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">avatar_url</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(512)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>U</B></TD><TD ALIGN="LEFT">bind_token</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">preferred_group_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">token_version</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"planner_events" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>planner_events</B><BR/><FONT POINT-SIZE="10">Дело планера</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(256)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">event_type</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">event_date</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">start_time</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIME</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">end_time</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIME</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">note</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(1024)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">reminder_minutes</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">done</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">reminder_sent</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">cal_uid</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">cal_dirty</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"reminders" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>reminders</B><BR/><FONT POINT-SIZE="10">Напоминание</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">remind_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">repeat_rule</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">repeat_anchor</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">sent</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"workouts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>workouts</B><BR/><FONT POINT-SIZE="10">Тренировка</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">ended_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">note</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">distance_km</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">NUMERIC(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"workout_exercises" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>workout_exercises</B><BR/><FONT POINT-SIZE="10">Упражнение</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">workout_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">sets</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">JSON</FONT></TD></TR></TABLE>>];
"car_refuels" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>car_refuels</B><BR/><FONT POINT-SIZE="10">Заправка</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">refuel_date</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">liters</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">NUMERIC(6,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">price_per_liter</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">NUMERIC(7,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">total_cost</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">NUMERIC(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">odometer_km</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">NUMERIC(9,1)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">station</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">fuel_type</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(8)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">full_tank</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">note</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"car_maintenance" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>car_maintenance</B><BR/><FONT POINT-SIZE="10">Обслуживание</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">service_date</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">service_type</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">cost</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">NUMERIC(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">km_at_service</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">NUMERIC(9,1)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">next_service_km</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">NUMERIC(9,1)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">next_service_date</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">note</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"car_profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>car_profiles</B><BR/><FONT POINT-SIZE="10">Автомобиль</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK,FK</B></TD><TD ALIGN="LEFT"><U>user_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">make</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">model</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">year</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">engine</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">transmission</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">regulation</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">regulation_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"weekly_reports" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>weekly_reports</B><BR/><FONT POINT-SIZE="10">Итоги недели</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">week_start</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">data</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"planner_events" -> "users" [arrowtail=crowodot, arrowhead=teeteenone, label="планирует"];
"reminders" -> "users" [arrowtail=crowodot, arrowhead=teeteenone, label="создаёт"];
"users" -> "workouts" [arrowtail=teeteenone, arrowhead=crowodot, label="записывает"];
"workouts" -> "workout_exercises" [arrowtail=teeteenone, arrowhead=crowodot, label="включает"];
