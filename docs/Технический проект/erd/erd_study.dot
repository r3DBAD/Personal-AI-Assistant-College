digraph ERD { graph [rankdir=LR, fontname="Liberation Sans", nodesep=0.35, ranksep=0.9, splines=spline, pad=0.3];
node [shape=plain, fontname="Liberation Sans", fontsize=11];
edge [fontname="Liberation Sans", fontsize=9, dir=both, color="#333333"];
"users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>users</B><BR/><FONT POINT-SIZE="10">Учётная запись</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>U</B></TD><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>U</B></TD><TD ALIGN="LEFT">telegram_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">is_admin</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">avatar_url</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(512)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>U</B></TD><TD ALIGN="LEFT">bind_token</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">preferred_group_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">token_version</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"user_features" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>user_features</B><BR/><FONT POINT-SIZE="10">Выданная возможность</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">feature</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">enabled</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">until</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">granted_by</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">note</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"app_settings" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>app_settings</B><BR/><FONT POINT-SIZE="10">Настройка</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">key</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">value</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"schedule_groups" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>schedule_groups</B><BR/><FONT POINT-SIZE="10">Учебная группа</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">file_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">parsed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"schedule_lessons" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>schedule_lessons</B><BR/><FONT POINT-SIZE="10">Занятие</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">group_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">day_label</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">time_slot</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">discipline</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(300)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">lesson_type</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">teacher</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">room</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">slot_order</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INTEGER</FONT></TD></TR></TABLE>>];
"subject_tasks" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>subject_tasks</B><BR/><FONT POINT-SIZE="10">Домашнее задание</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">discipline</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">completed</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">due_date</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">priority</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">completed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"projects" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>projects</B><BR/><FONT POINT-SIZE="10">Проект</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">sphere</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">color</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"tasks" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>tasks</B><BR/><FONT POINT-SIZE="10">Задача</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">priority</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">deadline</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"subtasks" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>subtasks</B><BR/><FONT POINT-SIZE="10">Подзадача</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">done</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">order</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">INTEGER</FONT></TD></TR></TABLE>>];
"task_tags" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6e6e6" COLSPAN="3"><B>task_tags</B><BR/><FONT POINT-SIZE="10">Метка задачи</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"> </TD><TD ALIGN="LEFT">tag</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">VARCHAR(50)</FONT></TD></TR></TABLE>>];
"users" -> "user_features" [arrowtail=teeteenone, arrowhead=crowodot, label="получает"];
"users" -> "app_settings" [arrowtail=teeteenone, arrowhead=crowodot, label="переопределяет"];
"users" -> "schedule_groups" [arrowtail=teeteenone, arrowhead=crowodot, label="загружает"];
"schedule_groups" -> "schedule_lessons" [arrowtail=teeteenone, arrowhead=crowodot, label="содержит"];
"schedule_groups" -> "users" [arrowtail=teeodot, arrowhead=crowodot, label="выбрана основной"];
"users" -> "subject_tasks" [arrowtail=teeteenone, arrowhead=crowodot, label="ведёт"];
"users" -> "projects" [arrowtail=teeteenone, arrowhead=crowodot, label="ведёт"];
"projects" -> "tasks" [arrowtail=teeteenone, arrowhead=crowodot, label="включает"];
"tasks" -> "subtasks" [arrowtail=teeteenone, arrowhead=crowodot, label="делится на"];
"tasks" -> "task_tags" [arrowtail=teeteenone, arrowhead=crowodot, label="помечена"];
}